# 운영 환경에서는 "production"으로 설정 (SQL 에코 로그 비활성화)
ENVIRONMENT=development
# 로그 레벨 — 기동 진단 로그가 INFO라 낮추면 원인 추적이 어려워진다
LOG_LEVEL=INFO

# 프론트엔드 배포 도메인 (쉼표로 여러 개 지정 가능)
CORS_ORIGINS=http://localhost:3000

# Supabase Postgres 연결 정보
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres

# 커넥션 풀 크기 — Supabase 풀러(또는 DB) 동시 접속 상한에 맞춰 조정
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 기동 시 `alembic upgrade head` 자동 실행 여부.
# 비워 두면 개발=true / 운영=false. 운영 배포 파이프라인에서 별도 단계로 적용한다면 false로 고정.
# RUN_MIGRATIONS_ON_STARTUP=

# Supabase Storage (월간 리포트 엑셀 원본 저장)
# Project Settings > API 에서 확인. service_role 키는 RLS를 우회하므로 서버에서만 사용
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=marketing-reports

# LLM — *_BASE_URL은 사내 라우터 등 게이트웨이를 거칠 때만 지정 (비우면 공급자 기본 엔드포인트)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-4-8
GEMINI_API_KEY=
# 이미지 모델 전용 키 — 게이트웨이가 모델별로 키를 끊어 발급하면 둘로 나뉜다. 비우면 GEMINI_API_KEY로 폴백
GEMINI_IMAGE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BASE_URL=

# LLM 호출 타임아웃·재시도 — 비우면 SDK 기본값(사실상 무한대)이라 응답이 안 오면 요청 스레드가 매달린다
LLM_TIMEOUT_SECONDS=60
LLM_IMAGE_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Mail (false로 설정하면 리포트 메일 발송 기능 전체 비활성화)
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 월간 리포트 자동 발송 스케줄
REPORT_CRON_HOUR=9
REPORT_CRON_DAY=1
REPORT_AUTO_RECIPIENTS=

# 키워드 순위 하락 알림 — 쉼표 구분 수신자. 비어 있으면 알림을 보내지 않는다.
RANK_ALERT_RECIPIENTS=
RANK_ALERT_CRON_HOUR=9

# 네이버 검색광고 API (M2 자동 수집). 비어 있으면 수집기가 비활성화되고 보고서 업로드만으로 동작한다.
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_BASE_URL=https://api.searchad.naver.com
# 매일 이 시각에 전일 확정치를 수집한다 (알림 평가는 수집 직후 이어서 돈다)
RANK_COLLECT_CRON_HOUR=8

# 수집 튜닝 — 매체 정책이 바뀔 때 배포 없이 조정할 수 있게 환경변수로 분리
NAVER_STATS_CHUNK=100
NAVER_BREAKDOWN_MAX_AGE_DAYS=6
RANK_ID_CACHE_DAYS=7
RANK_REPORT_MAX_ROWS=8

# Auth (JWT) — FastAPI가 발급/검증하는 access token 서명 키
# (Next.js의 AUTH_SECRET과는 별개의 값으로, 두 서버에 동일하게 설정할 필요는 없습니다)
# 생성 예: openssl rand -base64 32
# ENVIRONMENT=production 이면 32자 이상 필수 — 없으면 서버가 기동하지 않습니다.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# 업로드 상한 (MB)
# MAX_DATA_UPLOAD_MB: CSV·Excel 한 건(및 다중 업로드 합계) 상한
# MAX_REQUEST_MB: 모든 요청 본문의 상한 — 미들웨어가 Content-Length로 먼저 거릅니다.
MAX_DATA_UPLOAD_MB=50
MAX_REQUEST_MB=100

# 로그인 무차별 대입 방어 — 연속 실패가 임계값에 닿으면 해당 계정을 일시 잠급니다.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 요청 빈도 제한 (slowapi)
RATE_LIMIT_ENABLED=true
# 기본값은 프로세스 메모리라 인스턴스마다 카운터가 따로 놉니다.
# 인스턴스를 2개 이상 띄운다면 redis://HOST:6379/0 형태로 공유 저장소를 지정하세요.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_AI=30/hour
# 프록시(리버스 프록시·로드밸런서) 뒤에 있으면 X-Forwarded-For로 클라이언트 IP를 판별합니다.
TRUST_PROXY_HEADERS=true
