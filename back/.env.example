# 운영 환경에서는 "production"으로 설정 (SQL 에코 로그 비활성화)
ENVIRONMENT=development

# 프론트엔드 배포 도메인 (쉼표로 여러 개 지정 가능)
CORS_ORIGINS=http://localhost:3000

# Supabase Postgres 연결 정보
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres

# Supabase Storage (월간 리포트 엑셀 원본 저장)
# Project Settings > API 에서 확인. service_role 키는 RLS를 우회하므로 서버에서만 사용
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=marketing-reports

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mail (false로 설정하면 리포트 메일 발송 기능 전체 비활성화)
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 월간 리포트 자동 발송 스케줄
REPORT_CRON_HOUR=9
REPORT_CRON_DAY=1
REPORT_AUTO_RECIPIENTS=

# Auth (JWT) — FastAPI가 발급/검증하는 access token 서명 키
# (Next.js의 AUTH_SECRET과는 별개의 값으로, 두 서버에 동일하게 설정할 필요는 없습니다)
# 생성 예: openssl rand -base64 32
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
