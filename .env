# Supabase Postgres 연결 정보
# Supabase 대시보드 > Project Settings > Database > Connection string > URI 에서 복사
# 형식: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SQLAlchemy + psycopg2 사용을 위해 앞부분을 postgresql+psycopg2:// 로 바꾸고
# 비밀번호에 특수문자가 있으면 URL 인코딩 필요
DATABASE_URL=postgresql+psycopg2://postgres.foteslyvprpjriiqiefo:wndusdl_486@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

